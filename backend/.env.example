# ==============================================================================
# KMA Hub — Backend Environment Configuration
# ==============================================================================

# Application
APP_ENV=development
APP_NAME=KMA_Hub_API
APP_PORT=8000
API_PREFIX=/api

# Database MySQL Connection
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=kma_hub
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/kma_hub?charset=utf8mb4

# JWT Security
JWT_SECRET=kma_hub_super_secret_jwt_key_2025_actvn_cyber_sec
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Face AI & Geofencing Parameters
FACE_MATCH_MIN_PERCENT=85.0
FACE_MATCH_THRESHOLD_DISTANCE=0.45
DEFAULT_GPS_RADIUS_METERS=50.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5500", "http://127.0.0.1:5500", "http://localhost:3000", "*"]
